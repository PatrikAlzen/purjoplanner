{
  "name": "purjoplanner",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:api": "vitest run --config vitest-api.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
